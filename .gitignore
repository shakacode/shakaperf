!.yarn/sdks
!.yarn/versions
.pnp.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# Integration snapshots keep only the per-suite baseline logs and the
# report screenshots; every .log under snapshots/ is a tracked artifact.
!integration-tests/snapshots/**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Playwright
test-results/
playwright-report/
.playwright-mcp/

# Environment
.env
.env.local
.env.*.local

# Local Claude settings
.claude/settings.local.json

# Local Codex settings
.codex

# Visual Regression data (screenshots are inside html_report/)
**/visreg_data/html_report
**/visreg_data/ci_report/xunit.xml

packages/shaka-perf/tracerbench-results
tracerbench-results

# Integration snapshot review scratch regenerated by compare-screenshots.mjs
# (the top-level screenshot-diff-report.html it also writes stays tracked)
integration-tests/snapshots/.screenshot-diff/

shaka-perf-orb.yml

# polish-loop local scratch (per-artifact iteration history)
.polish-history/
