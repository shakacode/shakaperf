# Dockerignore for demo-ecommerce production build
# Build context is the monorepo root, so paths are prefixed with demo-ecommerce/

# Ignore credentials (generated inside Docker during build)
demo-ecommerce/config/master.key
demo-ecommerce/config/credentials.yml.enc
demo-ecommerce/config/credentials/*.key

# Ignore git directory
.git/

# Ignore host dependency installs; keep committed Yarn releases and plugins.
**/node_modules/
**/.pnp.*
**/.yarn/install-state.gz
**/.yarn/build-state.yml
**/.yarn/unplugged/
**/.yarn/cache/
**/.yarn/sdks/
**/.bundle/
**/vendor/bundle/
packages/**/build/

# Ignore logs, tmp, storage
demo-ecommerce/log/*
demo-ecommerce/tmp/*
demo-ecommerce/storage/*

# Ignore host-side Shaka Perf results (these can be many gigabytes)
audit-results*/
**/audit-results*/
compare-bisect-results*/
**/compare-bisect-results*/
compare-results*/
**/compare-results*/
troubleshoot-results*/
**/troubleshoot-results*/

# Ignore built assets (rebuilt in Docker)
demo-ecommerce/public/assets
demo-ecommerce/public/packs/
demo-ecommerce/public/packs-test/
demo-ecommerce/ssr-generated/
demo-ecommerce/.swc/
demo-ecommerce/app/javascript/**/generated/
demo-ecommerce/app/assets/builds/*

# Workspace package contents the demo's container never uses. Kept out of
# the build context so host-side edits (TypeScript saves, host-only test
# runs, template tweaks) don't invalidate the docker image.
#
# What we keep: each package's `package.json` (workspace resolution),
# `binding.gyp` + `native/` (the dependency layer runs shaka-perf's
# `build-native` script against these inside the container), and anything
# else not explicitly listed below.
packages/**/dist
packages/**/src
packages/**/__tests__
packages/**/test
packages/**/tests
packages/**/templates
